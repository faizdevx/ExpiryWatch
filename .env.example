# Copy to .env. Placeholders only: never commit real values.

# Local Docker Postgres listens on 5433 (see compose.yaml).
DATABASE_URL=postgresql+psycopg://expirywatch:change-me@localhost:5433/expirywatch
POSTGRES_PASSWORD=change-me

# development | test | production
APP_ENV=development

# Blank in development: writes are open. Required in production.
APP_API_KEY=

EXTERNAL_API_BASE_URL=https://world.openfoodfacts.org
EXPIRY_WARNING_DAYS=30
LOG_LEVEL=INFO

# IANA name that decides what "today" means, e.g. Asia/Kolkata.
APP_TIMEZONE=UTC
